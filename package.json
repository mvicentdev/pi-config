{
  "name": "pi-config",
  "private": true,
  "description": "Configuración común de pi para todos sus usuarios",
  "scripts": {
    "postinstall": "for p in patches/*.patch; do patch -d node_modules -p1 -R -s -f --dry-run < \"$p\" >/dev/null || patch -d node_modules -p1 -s < \"$p\" || exit 1; done"
  },
  "dependencies": {
    "@amaster.ai/pi-attachments": "^0.1.18",
    "@dietrichgebert/ponytail": "github:DietrichGebert/ponytail",
    "@ff-labs/pi-fff": "^0.11.0",
    "@juicesharp/rpiv-ask-user-question": "^2.11.0",
    "@tintinweb/pi-subagents": "^0.19.0",
    "awesome-pi-themes": "^1.2.13",
    "pi-btw": "^0.6.0",
    "pi-context-view": "^0.6.0"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/@amaster.ai/pi-attachments/dist/index.js",
      "./node_modules/@dietrichgebert/ponytail/pi-extension/index.js",
      "./node_modules/@ff-labs/pi-fff/src/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@tintinweb/pi-subagents/src/index.ts",
      "./node_modules/awesome-pi-themes/extensions",
      "./node_modules/pi-btw/extensions/btw.ts",
      "./node_modules/pi-context-view/src/index.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/@dietrichgebert/ponytail/skills",
      "./node_modules/pi-btw/skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes",
      "./node_modules/awesome-pi-themes/themes"
    ]
  }
}
